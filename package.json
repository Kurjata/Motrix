{
  "name": "catalogo-pecas-automotivas",
  "version": "1.3.0",
  "private": true,
  "description": "Catalogo - Pecas Automotivas: importa catalogos e tabelas de preco das fabricas, consolida o DE-PARA e exporta o catalogo de apresentacao",
  "type": "commonjs",
  "main": "desktop/main.js",
  "author": "Felipe Kurjata",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "npm run preparar:desktop && electron .",
    "icone": "node scripts/gerar-icone.js",
    "dist": "npm run icone && npm run preparar:desktop && electron-builder --win",
    "capturas": "electron scripts/gerar-capturas.js",
    "manual": "electron scripts/gerar-manual.js",
    "preparar:desktop": "electron-rebuild -f --only better-sqlite3",
    "preparar:node": "npm rebuild better-sqlite3"
  },
  "build": {
    "appId": "com.kurjata.catalogopecasautomotivas",
    "productName": "Catálogo - Peças Automotivas",
    "copyright": "Felipe Kurjata",
    "directories": {
      "output": "dist",
      "buildResources": "desktop"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/canvas/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icone.ico"
    },
    "portable": {
      "artifactName": "Catalogo-Pecas-Automotivas-${version}-portatil.${ext}"
    },
    "nsis": {
      "artifactName": "Catalogo-Pecas-Automotivas-${version}-instalador.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Catálogo - Peças Automotivas",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ag-psd": "^31.0.2",
    "better-sqlite3": "^11.7.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "image-size": "^1.2.0",
    "mammoth": "^1.9.0",
    "multer": "^2.2.0",
    "node-html-parser": "^6.1.13",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
